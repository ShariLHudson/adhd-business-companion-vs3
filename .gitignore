# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# companion audit guardrail state (local)
.companion-audit-state.json
.audit-data.json

# local extract / scratch (never commit)
.tmp/
.tmp-*
eng.traineddata
**/__pycache__/
*.bak
*.before-edge-fix.png

# one-off GPT / navigation dump packets at repo root (local reference only)
/GPT-*.docx
/GPT-*.pdf
/GPT-*.zip
# ...and the same packets delivered as folders (the patterns above match files only)
/GPT-*/
/personal-assistant-navigation.pdf
/Spark_Estate_GPT_Reverse_Engineering_Report.docx
.turbopack-build-log.txt
/066_CURRENT_UNCOMMITTED_WORK_RECOVERY_REPORT.md
/public/achived images/
/public/backgrounds/*(1).*

# local Claude Code dev-server launch config — machine-specific absolute paths
.claude/

# authoring source material (.docx/.zip/.pdf bundles + raw card seeds).
# Upstream of the app, never imported at runtime: transformed catalog data is
# copied into lib/sparkNote/volumes/ (see that folder's index.ts).
# Also excluded in tsconfig.json — .gitignore alone does not hide it from tsc.
/Intelligence Library/
